# Local fixture settings. Use platform secrets for hosted deployment.
HL_MODE=fixture
WEB_PORT=3000
API_PORT=4000
CONTROL_DB_PORT=55432
SANDBOX_DB_PORT=55433

# Host CLI values. Compose passes service-specific equivalents to app containers.
CONTROL_API_DSN=postgresql://hl_api:fixture_api@127.0.0.1:55432/harnesslab_control
CONTROL_DISPATCHER_DSN=postgresql://hl_dispatcher:fixture_dispatcher@127.0.0.1:55432/harnesslab_control
CONTROL_MIGRATOR_DSN=postgresql://hl_migrator:fixture_migrator@127.0.0.1:55432/harnesslab_control
CONTROL_PROMOTER_DSN=postgresql://hl_promoter:fixture_promoter@127.0.0.1:55432/harnesslab_control
SANDBOX_SEED_DSN=postgresql://hl_seed:fixture_seed@127.0.0.1:55433/harnesslab_sandbox

# Private service addresses inside Compose.
REDIS_URL=redis://redis:6379/0
RUNNER_URL=http://runner:8000
EVALUATOR_URL=http://evaluator:8000
OPTIMIZER_URL=http://optimizer:8000

# Runtime map files are split-scoped JSON objects mapping variant_id to a read-only DSN.
# The holdout map is reserved for the separate holdout job.
HL_SANDBOX_DEV_RUNTIME_MAP_FILE=
HL_SANDBOX_VALIDATION_RUNTIME_MAP_FILE=
HL_SANDBOX_HOLDOUT_RUNTIME_MAP_FILE=

# Trusted release profiles for live-capable deployments.
HL_WORKER_PROFILE_FILE=
HL_OPTIMIZER_PROFILE_FILE=
HL_PRICE_PROFILE_FILE=
HL_MAX_EXPERIMENT_MICRO_USD=0
OPENAI_API_KEY=

# Test-only holdout database. The holdout job uses a separate operator environment.
HOLDOUT_DB_PORT=55434
HL_FIXTURE_HOLDOUT_SEED_DSN=postgresql://hl_holdout_seed:fixture_holdout_seed@127.0.0.1:55434/harnesslab_holdout

# Private service configuration. Compose supplies fixture-only token values.
HL_DISPATCHER_ARTIFACT_DIR=
HL_EVALUATOR_ARTIFACT_DIR=
HL_RUNNER_TOKEN=
HL_EVALUATOR_TOKEN=
HL_WORKER_CHECKPOINT_TOKEN=
HL_OPTIMIZER_CHECKPOINT_TOKEN=
# Set separately inside each Python service to the dispatcher's token for that service.
HL_DISPATCHER_TOKEN=
